{
	"useTabs": true,
	"tabWidth": 2,
	"singleQuote": true,
	"semi": true,
	"printWidth": 100,
	"trailingComma": "all",
	"plugins": ["prettier-plugin-astro"],
	"overrides": [
		{
			"files": "*.astro",
			"options": { "parser": "astro" }
		},
		{
			"files": ["*.md", "*.mdx", "*.yml", "*.yaml"],
			"options": { "useTabs": false, "tabWidth": 2 }
		}
	]
}
