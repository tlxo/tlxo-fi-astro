---
import FormattedDate from './FormattedDate.astro';
import TagList from './TagList.astro';
import { isNote, type Post } from '../lib/content';

interface Props {
	post: Post;
	headingLevel?: 'h2' | 'h3';
}

const { post, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
const note = isNote(post);
const href = `/blog/${post.id}/`;
---

<article class="post-card">
	<p class="post-card__meta">
		<FormattedDate date={post.data.pubDate} />
		{note && <span class="post-card__badge">Note</span>}
	</p>

	<Heading class="post-card__title">
		<a href={href}>{post.data.title}</a>
	</Heading>

	<p class="post-card__description">{post.data.description}</p>

	<TagList tags={post.data.tags} label={`Tags for ${post.data.title}`} />
</article>

<style>
	.post-card__meta {
		display: flex;
		gap: var(--space-2xs);
		font-size: var(--text-sm);
		color: var(--color-text-muted);
		margin-bottom: var(--space-3xs);
	}

	.post-card__badge {
		border: var(--border-thin);
		border-radius: var(--radius-sm);
		padding: 0 var(--space-3xs);
		color: var(--color-accent-soft);
	}

	.post-card__title {
		font-size: var(--text-lg);
		margin-bottom: var(--space-3xs);
	}

	.post-card__title a {
		text-decoration: none;
	}

	.post-card__title a:hover,
	.post-card__title a:focus-visible {
		text-decoration: underline;
	}

	.post-card__description {
		margin-bottom: var(--space-2xs);
		color: var(--color-text-muted);
	}
</style>
