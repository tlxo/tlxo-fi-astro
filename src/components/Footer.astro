---
import { SITE, SOCIAL } from '../consts';

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container container--wide site-footer__inner">
		<p>&copy; {year} {SITE.title}</p>

		<ul class="site-footer__links">
			<li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
			{
				SOCIAL.map((link) => (
					<li>
						<a href={link.href} rel="me">
							{link.label}
						</a>
					</li>
				))
			}
			<li><a href="/rss.xml">RSS</a></li>
		</ul>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: auto;
		border-top: var(--border-thin);
		padding-block: var(--space-md);
		font-size: var(--text-sm);
		color: var(--color-text-muted);
	}

	.site-footer__inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-sm);
	}

	.site-footer p {
		margin: 0;
	}

	.site-footer__links {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-md);
		list-style: none;
		margin: 0;
		padding: 0;
	}
</style>
