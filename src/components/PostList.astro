---
import PostCard from './PostCard.astro';
import type { Post } from '../lib/content';

interface Props {
	posts: Post[];
	emptyMessage?: string | undefined;
	headingLevel?: 'h2' | 'h3' | undefined;
}

const { posts, emptyMessage = 'Nothing here yet.', headingLevel = 'h2' } = Astro.props;
---

{
	posts.length === 0 ? (
		<p>{emptyMessage}</p>
	) : (
		<ul class="post-list">
			{posts.map((post) => (
				<li data-post-tags={post.data.tags.join(' ')}>
					<PostCard post={post} headingLevel={headingLevel} />
				</li>
			))}
		</ul>
	)
}

<style>
	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: var(--space-lg);
	}
</style>
