---
import { SITE } from '../consts';

interface Props {
	title: string;
	description?: string;
	/** Absolute or root-relative path; resolved against the site origin. */
	image?: string;
	type?: 'website' | 'article';
	publishedDate?: Date;
	updatedDate?: Date;
	tags?: readonly string[];
	noindex?: boolean;
}

const {
	title,
	description = SITE.description,
	image = SITE.defaultOgImage,
	type = 'website',
	publishedDate,
	updatedDate,
	tags,
	noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
const isHome = Astro.url.pathname === '/';
const fullTitle = isHome ? SITE.title : `${title} — ${SITE.title}`;

const schema = isHome
	? {
			'@context': 'https://schema.org',
			'@type': 'Person',
			name: SITE.title,
			url: SITE.url,
			email: `mailto:${SITE.email}`,
			description: SITE.description,
		}
	: {
			'@context': 'https://schema.org',
			'@type': type === 'article' ? 'BlogPosting' : 'WebPage',
			headline: title,
			description,
			url: canonical.href,
			...(publishedDate && { datePublished: publishedDate.toISOString() }),
			...(updatedDate && { dateModified: updatedDate.toISOString() }),
			...(tags?.length && { keywords: tags.join(', ') }),
		};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:site_name" content={SITE.title} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:locale" content="en" />
{publishedDate && <meta property="article:published_time" content={publishedDate.toISOString()} />}
{updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

<link rel="icon" href="/images/icon.svg" type="image/svg+xml" sizes="any" />
<link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
<link rel="webmention" href="https://webmention.io/tlxo.fi/webmention" />
<link rel="alternate" type="application/rss+xml" title={`${SITE.title} — Blog`} href="/rss.xml" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Lexend+Deca&display=swap" rel="stylesheet" />

<script is:inline set:html={JSON.stringify(schema)} type="application/ld+json" />
