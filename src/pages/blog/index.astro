---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import Pagination from '../../components/Pagination.astro';
import TagFilter from '../../components/react/TagFilter.tsx';
import { getPublishedPosts } from '../../lib/content';
import { POSTS_PER_PAGE } from '../../consts';

const posts = await getPublishedPosts();
const totalPages = Math.max(1, Math.ceil(posts.length / POSTS_PER_PAGE));
const pagePosts = posts.slice(0, POSTS_PER_PAGE);

// Only tags present on this page can be filtered without a round-trip.
const counts = new Map<string, number>();
for (const post of pagePosts) {
	for (const tag of post.data.tags) {
		counts.set(tag, (counts.get(tag) ?? 0) + 1);
	}
}
const visibleTags = [...counts.entries()]
	.map(([tag, count]) => ({ tag, count }))
	.sort((a, b) => b.count - a.count || a.tag.localeCompare(b.tag));
---

<BaseLayout
	title="Blog"
	description="Writing about UX, music, instruments, and whatever happens to float my boat."
>
	<h1>Blog</h1>
	<p>
		Everything I write, newest first. Posts about work and hobby projects, short notes, and whatever
		else catches my attention, all live here — use <a href="/tags/">tags</a> to narrow it down.
	</p>

	<TagFilter client:idle tags={visibleTags} totalPosts={pagePosts.length} />

	<PostList posts={pagePosts} emptyMessage="No posts published yet." />
	<Pagination currentPage={1} totalPages={totalPages} />
</BaseLayout>
