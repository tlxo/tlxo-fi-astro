---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import TlxoLogo from '../components/TlxoLogo.astro';
import { getPublishedPosts, getFeaturedProjects } from '../lib/content';
import { SITE } from '../consts';

const latest = (await getPublishedPosts()).slice(0, 5);
const featured = await getFeaturedProjects();
const logoText = 'tlxo';
const titlePrefix = SITE.title.replace(logoText, '').trimEnd();
---

<BaseLayout title={SITE.title} description={SITE.description}>
	<section class="intro">
		<h1 class="intro__title">
			<span>{titlePrefix}</span>
			<TlxoLogo class="intro__logo" label={logoText} />
		</h1>
		<p class="intro__tagline">{SITE.tagline}</p>
	</section>

	<section aria-labelledby="latest-heading">
		<h2 id="latest-heading">Latest writing</h2>
		<PostList posts={latest} headingLevel="h3" emptyMessage="Nothing published yet — soon." />
		<p><a href="/blog/">All posts &rarr;</a></p>
	</section>

	{
		featured.length > 0 && (
			<section aria-labelledby="projects-heading">
				<h2 id="projects-heading">Selected projects</h2>
				<ul class="featured">
					{featured.map((project) => (
						<li>
							<h3>
								<a href={`/projects/${project.id}/`}>{project.data.title}</a>
							</h3>
							<p>{project.data.summary}</p>
						</li>
					))}
				</ul>
				<p>
					<a href="/projects/">All projects &rarr;</a>
				</p>
			</section>
		)
	}
</BaseLayout>

<style>
	.intro {
		margin-bottom: var(--space-xl);
	}

	.intro__title {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5em;
	}

	.intro__tagline {
		font-size: var(--text-lg);
		color: var(--color-text-muted);
	}

	section + section {
		margin-top: var(--space-xl);
	}

	.featured {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: var(--space-md);
	}

	.featured h3 {
		font-size: var(--text-lg);
		margin-bottom: var(--space-3xs);
	}
</style>
