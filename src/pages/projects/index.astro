---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedProjects } from '../../lib/content';
import { PROJECT_KIND_LABELS } from '../../consts';

const projects = await getPublishedProjects();
---

<BaseLayout title="Projects" description="Selected work and side projects.">
	<h1>Projects</h1>
	<p>Things I have built, recorded, made or written.</p>

	{
		projects.length === 0 ? (
			<p>No projects listed yet.</p>
		) : (
			<ul class="project-list">
				{projects.map((project) => (
					<li>
						<article>
							<p class="project-list__meta">
								{project.data.year} · {PROJECT_KIND_LABELS[project.data.kind].label}
							</p>
							<h2>
								<a href={`/projects/${project.id}/`}>{project.data.title}</a>
							</h2>
							<p>{project.data.summary}</p>
							{project.data.madeWith.length > 0 && (
								<p class="project-list__meta">{project.data.madeWith.join(' · ')}</p>
							)}
						</article>
					</li>
				))}
			</ul>
		)
	}
</BaseLayout>

<style>
	.project-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: var(--space-lg);
	}

	.project-list h2 {
		font-size: var(--text-lg);
		margin-bottom: var(--space-3xs);
	}

	.project-list h2 a {
		text-decoration: none;
	}

	.project-list h2 a:hover,
	.project-list h2 a:focus-visible {
		text-decoration: underline;
	}

	.project-list__meta {
		font-size: var(--text-sm);
		color: var(--color-text-muted);
		margin-bottom: var(--space-3xs);
	}
</style>
