---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPostsByTag, getPublishedProjects } from '../../lib/content';
import { PROJECT_KIND_LABELS } from '../../consts';

export async function getStaticPaths() {
	const projects = await getPublishedProjects();
	return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, role, year, kind, tag, madeWith, links, cover, coverAlt } = project.data;
const vocabulary = PROJECT_KIND_LABELS[kind];
const relatedPosts = tag
	? (await getPostsByTag(tag)).sort((a, b) => {
			const dateA = a.data.updatedDate ?? a.data.pubDate;
			const dateB = b.data.updatedDate ?? b.data.pubDate;
			return dateA.valueOf() - dateB.valueOf() || a.data.title.localeCompare(b.data.title);
		})
	: [];
---

<BaseLayout title={title} description={summary}>
	<article data-pagefind-body>
		<p class="project__year">{year} · {vocabulary.label}{role && ` · ${role}`}</p>
		<h1>{title}</h1>

		{cover && <Image src={cover} alt={coverAlt ?? ''} class="project__cover" widths={[480, 800]} />}

		<div class="prose">
			<Content />
		</div>

		{relatedPosts.length > 0 && (
			<>
				<h2>Related posts</h2>
				<ul>
					{relatedPosts.map((post) => {
						const date = post.data.updatedDate ?? post.data.pubDate;
						return (
							<li>
								<a href={`/blog/${post.id}/`}>{post.data.title}</a> (
								<time datetime={date.toISOString()}>{date.toISOString().slice(0, 10)}</time>)
							</li>
						);
					})}
				</ul>
			</>
		)}

		{
			madeWith.length > 0 && (
				<>
					<h2>{vocabulary.madeWith}</h2>
					<p>{madeWith.join(' · ')}</p>
				</>
			)
		}

		{
			links.length > 0 && (
				<ul class="project__links">
					{links.map((link) => (
						<li>
							<a href={link.url} rel="noopener noreferrer external">
								{link.label}
							</a>
						</li>
					))}
				</ul>
			)
		}

		<p><a href="/projects/">&larr; All projects</a></p>
	</article>
</BaseLayout>

<style>
	.project__year {
		font-size: var(--text-sm);
		color: var(--color-text-muted);
		margin-bottom: var(--space-3xs);
	}

	.project__cover {
		width: 100%;
		border-radius: var(--radius-md);
		margin-bottom: var(--space-md);
	}

	.project__links {
		list-style: none;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-md);
	}
</style>
