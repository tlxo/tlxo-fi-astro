---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedProjects } from '../../lib/content';

export async function getStaticPaths() {
	const projects = await getPublishedProjects();
	return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, role, year, tech, url, repo, cover, coverAlt } = project.data;
---

<BaseLayout title={title} description={summary}>
	<article>
		<p class="project__year">{year}{role && ` · ${role}`}</p>
		<h1>{title}</h1>

		{cover && <Image src={cover} alt={coverAlt ?? ''} class="project__cover" widths={[480, 800]} />}

		<div class="prose">
			<Content />
		</div>

		{
			tech.length > 0 && (
				<>
					<h2>Built with</h2>
					<p>{tech.join(' · ')}</p>
				</>
			)
		}

		{
			(url || repo) && (
				<ul class="project__links">
					{url && (
						<li>
							<a href={url} rel="noopener noreferrer external">
								Visit site
							</a>
						</li>
					)}
					{repo && (
						<li>
							<a href={repo} rel="noopener noreferrer external">
								Source code
							</a>
						</li>
					)}
				</ul>
			)
		}

		<p><a href="/projects/">&larr; All projects</a></p>
	</article>
</BaseLayout>

<style>
	.project__year {
		font-size: var(--text-sm);
		color: var(--color-text-muted);
		margin-bottom: var(--space-3xs);
	}

	.project__cover {
		width: 100%;
		border-radius: var(--radius-md);
		margin-bottom: var(--space-md);
	}

	.project__links {
		list-style: none;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-md);
	}
</style>
