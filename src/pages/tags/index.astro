---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllTags } from '../../lib/content';

const tags = await getAllTags();
---

<BaseLayout title="Tags" description="Browse everything on this site by topic.">
	<h1>Tags</h1>
	<p>Everything is filed by tag — work, personal, notes and topics.</p>

	{
		tags.length === 0 ? (
			<p>No tags yet.</p>
		) : (
			<ul class="tag-index">
				{tags.map(({ tag, count }) => (
					<li>
						<a href={`/tags/${tag}/`}>#{tag}</a>
						<span class="tag-index__count">
							{count} {count === 1 ? 'post' : 'posts'}
						</span>
					</li>
				))}
			</ul>
		)
	}
</BaseLayout>

<style>
	.tag-index {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: var(--space-2xs);
	}

	.tag-index li {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-sm);
		border-bottom: var(--border-thin);
		padding-bottom: var(--space-2xs);
	}

	.tag-index__count {
		font-size: var(--text-sm);
		color: var(--color-text-muted);
	}
</style>
