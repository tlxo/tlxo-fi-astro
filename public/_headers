*
    X-Content-Type-Options: nosniff
    X-Frame-Options: DENY
    Referrer-Policy: strict-origin-when-cross-origin
    Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
    Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://gc.zgo.at; font-src 'self'; connect-src 'self' https://tlxofi.goatcounter.com/count; form-action 'none'; frame-ancestors 'none'; base-uri 'self'; object-src 'none';
/_astro/*
    Cache-Control: public, max-age=31536000, immutable
/pagefind/*
    Cache-Control: public, max-age=3600
/rss.xml
    Cache-Control: public, max-age=3600
    Content-Type: application/rss+xml; charset=utf-8